    "1. Prepare": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Prepárese"
          }
        }
      }
    },
    "2. Record": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Registre"
          }
        }
      }
    },
    "3. Your result": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Su resultado"
          }
        }
      }
    },
    "A check-in is one saved session of a routine in your plan. A week runs Monday to Sunday.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un registro es una sesión guardada de una rutina de su plan. La semana va de lunes a domingo."
          }
        }
      }
    },
    "A guided arm raise. A record you can return to.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un movimiento guiado del brazo. Un registro para consultar después."
          }
        }
      }
    },
    "A larger or smaller number does not tell you whether your health changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número mayor o menor no indica si su salud cambió."
          }
        }
      }
    },
    "A manual entry does not confirm how a movement was done.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una entrada manual no confirma cómo se hizo un movimiento."
          }
        }
      }
    },
    "A phone camera sees a flat picture, not 3D. This number estimates an angle in that picture.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara ve una imagen plana, no en 3D. Este número estima un ángulo en esa imagen."
          }
        }
      }
    },
    "A phone camera sees a flat picture, not 3D. This number estimates the angle in the picture. It does not show how far your shoulder can move.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara ve una imagen plana, no en 3D. Este número estima el ángulo en la imagen. No muestra cuánto puede mover el hombro."
          }
        }
      }
    },
    "A temporary PDF is created only when you tap Create PDF summary.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se crea un PDF temporal cuando toca Crear resumen PDF."
          }
        }
      }
    },
    "All routines": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las rutinas"
          }
        }
      }
    },
    "All sessions, settings, and temporary PDFs were deleted.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borraron todas las sesiones, los ajustes y los PDF temporales."
          }
        }
      }
    },
    "Allow reminders?": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Permitir recordatorios?"
          }
        }
      }
    },
    "Angle summary": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen del ángulo"
          }
        }
      }
    },
    "Angle summary: %.0f degrees": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen del ángulo: %.0f grados"
          }
        }
      }
    },
    "Angles use the shoulder, hip, and elbow in a flat phone camera picture.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ángulos usan el hombro, la cadera y el codo en una imagen plana del teléfono."
          }
        }
      }
    },
    "Ankle height marks the lifted foot. Hip movement compared with shoulder width estimates sway.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La altura del tobillo indica el pie levantado. El movimiento de caderas y ancho de hombros estiman oscilación."
          }
        }
      }
    },
    "Arm": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazo"
          }
        }
      }
    },
    "Arm angle summary": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen del ángulo del brazo"
          }
        }
      }
    },
    "Arm angle summary: %.0f degrees": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen del ángulo del brazo: %.0f grados"
          }
        }
      }
    },
    "Arm raise": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimiento del brazo"
          }
        }
      }
    },
    "Ask them to level their shoulders.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídale que nivele los hombros."
          }
        }
      }
    },
    "Ask them to lift one foot and hold it after Start.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídale que levante un pie y lo mantenga después de Comenzar."
          }
        }
      }
    },
    "Ask them to raise their left arm out to the side.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídale que levante el brazo izquierdo hacia el lado."
          }
        }
      }
    },
    "Ask them to raise their right arm out to the side.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídale que levante el brazo derecho hacia el lado."
          }
        }
      }
    },
    "Ask them to sit and cross their arms.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídale que se siente y cruce los brazos."
          }
        }
      }
    },
    "Ask them to stand in the picture.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídale que se pare dentro de la imagen."
          }
        }
      }
    },
    "Ask them to stand tall with a straight back.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídale que se pare derecho, con la espalda recta."
          }
        }
      }
    },
    "Ask them to turn so their left side faces the camera.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídale que gire para que su lado izquierdo mire a la cámara."
          }
        }
      }
    },
    "Ask them to turn so their right side faces the camera.": {
      "comment": "needs_review",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídale que gire para que su lado derecho mire a la cámara."
          }
        }
      }
    },
    "Attempt %lld of %lld": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intento %1$lld de %2$lld"
